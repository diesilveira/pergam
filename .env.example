# Copy to .env and fill in. .env is gitignored.
# All values below have safe defaults baked into docker-compose.yml — only
# override what you need to change for your environment.

# Postgres credentials for the bundled `db` service. Change in production.
POSTGRES_PASSWORD=pergam

# Public base URL the server uses to build returned view URLs. Set it to
# whatever your users will type into a browser, e.g. behind a reverse proxy:
#   PUBLIC_URL=https://pergam.example.com
# When unset, the URL is built from PUBLIC_HOST/PUBLIC_PORT (443 means https).
# PUBLIC_URL=
PUBLIC_HOST=localhost
PUBLIC_PORT=1111

# Accepted pergam types, comma separated. Unset means the five defaults:
# PERGAM_TYPES=plan,investigacion,informe,reporte,otro

# Largest request body in MB (POST /pergam, POST /import, PATCH). Default 256.
# PERGAM_MAX_BODY_MB=256

# Host port the app binds to. Override if 1111 collides with something local.
PERGAM_PORT=1111

# Advanced: override the database the app connects to. Useful when pointing at
# an external Postgres instead of the bundled `db` service.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
