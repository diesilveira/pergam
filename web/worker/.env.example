# Copy to .env and fill in. web/worker/.env is gitignored.
#
# KV namespace id for the pergam.dev share Worker. This is a resource
# identifier, not a secret, but it is kept out of version control so the
# public wrangler.toml carries no account-specific ids. Create the namespace
# once with `wrangler kv namespace create pergam_shares` and paste the id here.
PERGAM_KV_ID=your-kv-namespace-id
